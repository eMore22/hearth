{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hearth-hq.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_ROUTER_APP_ROOT": "./app",
        "EXPO_PUBLIC_API_URL": "https://hearth-hq.onrender.com"
      }
    }
  }
}
