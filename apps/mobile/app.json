{
  "expo": {
    "name": "Hearth",
    "slug": "hearth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hearth.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Hearth needs camera access to scan your documents.",
        "NSPhotoLibraryUsageDescription": "Hearth needs photo access to upload your documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.hearth.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E3A5F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hearth needs camera access to scan your documents."
        }
      ]
    ],
    "scheme": "hearth",
    "extra": {
      "router": {
        "origin": ""
      },
      "eas": {
        "projectId": "cbdcf3cb-ccb0-41db-8abd-4a63fc0364d4"
      }
    }
  }
}